# Copy this file to `.env` and change what you need. `.env` is git-ignored.
# Every setting is optional; the defaults shown work out of the box with the
# synthetic practice data.

# --- Sheet ---
# Tabs to check, separated by commas.
SHEET_TABS=Form Responses 1,Manual Entries
# "mock" = practice sheet saved in work/mock_sheet.json (Google Sheets: Milestone 5)
SHEET_BACKEND=mock

# --- Tracking ---
# "mock" = synthetic statuses from data/mock_shipments.json (FedEx: Milestone 7)
TRACKING_PROVIDER=mock

# --- Logs ---
# LOG_DIR=logs

# --- AI summary ---
# Claude API key from https://console.anthropic.com. Leave blank to skip the
# summary; everything else still works. NEVER commit a real key.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Secrets for later milestones (never commit real values) ---
# Milestone 5: Google service account key file and the spreadsheet's ID
GOOGLE_SERVICE_ACCOUNT_FILE=
SPREADSHEET_ID=
